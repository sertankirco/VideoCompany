# ── Instagram Graph API ──────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=your_instagram_long_lived_access_token_here
INSTAGRAM_USER_ID=your_instagram_business_account_id_here

# ── TikTok Content Posting API v2 ────────────────────────────
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here
TIKTOK_CLIENT_KEY=your_tiktok_app_client_key_here

# ── YouTube Data API v3 (OAuth2) ─────────────────────────────
YOUTUBE_API_KEY=your_youtube_data_api_key_here
YOUTUBE_CLIENT_ID=your_oauth2_client_id_here
YOUTUBE_CLIENT_SECRET=your_oauth2_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_oauth2_refresh_token_here

# ── Render Engine ─────────────────────────────────────────────
AERENDER_PATH=/path/to/aerender
AFTERFX_PATH=/path/to/AfterEffects

# ── Publisher Settings ────────────────────────────────────────
PUBLISHER_ENABLED_PLATFORMS=instagram,tiktok,youtube
PUBLISHER_OUTPUT_DIR=output/
